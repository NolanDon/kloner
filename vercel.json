{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "regions": ["sin1"],
  "crons": [
    {
      "path": "/api/cron/daily-url-scan-report",
      "schedule": "0 0 * * *"
    }
  ],
  "functions": {
    "app/api/**/*.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/private/send-journey-emails",
      "schedule": "0 14 * * *"
    }
  ],
  "env": {
    "BACKEND_URL": "https://tracksite-hub.fly.dev"
  }
}
