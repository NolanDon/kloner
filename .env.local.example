# Local environment variables (copy to .env.local)
# IMPORTANT:
# - Do NOT commit .env.local
# - NEXT_PUBLIC_* variables are exposed to the browser

# Mixpanel
NEXT_PUBLIC_MIXPANEL_TOKEN=
# Optional kill-switch (set to 1 to disable analytics locally)
NEXT_PUBLIC_MIXPANEL_DISABLED=0

# Session Replay (Web)
# Start in a sandbox project with 100, then lower for production.
NEXT_PUBLIC_MIXPANEL_RECORD_SESSIONS_PERCENT=100
# Optional: enable heatmaps/rage clicks/dead clicks during recorded sessions
NEXT_PUBLIC_MIXPANEL_RECORD_HEATMAP_DATA=0

# Server-only Mixpanel token (do NOT prefix with NEXT_PUBLIC)
# Only needed if you later add server-side Mixpanel API calls.
MIXPANEL_API_TOKEN=

# Firestore transport (optional)
# If you see Firestore WebChannel / INTERNAL ASSERTION errors in dev (often VPN/proxy/HMR related),
# long polling is slower but typically more reliable.
NEXT_PUBLIC_FIRESTORE_FORCE_LONG_POLLING=0
NEXT_PUBLIC_FIRESTORE_AUTO_DETECT_LONG_POLLING=0

# Firestore Admin SDK (server) transport (optional)
# If you see server logs like "Received RST_STREAM" or "read EADDRNOTAVAIL" when hitting API routes,
# force the Admin SDK to use REST (HTTP/1.1) instead of gRPC.
FIRESTORE_PREFER_REST=true

# Preview iframe alert thresholds (ms)
# Warn at 30s by default; escalate to critical at 120s if still not ready.
NEXT_PUBLIC_PREVIEW_IFRAME_WARN_MS=30000
NEXT_PUBLIC_PREVIEW_IFRAME_CRITICAL_MS=120000
# Optional aliases if your build pipeline injects non-public names into the client bundle.
PREVIEW_IFRAME_WARN_MS=30000
PREVIEW_IFRAME_CRITICAL_MS=120000
